{
  "appId": "com.nchristen.gymtrack",
  "appName": "GYMTRACK",
  "webDir": "www",
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false,
    "scheme": "GYMTRACK",
    "backgroundColor": "#0a0a0a"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#d4ff3a",
      "sound": "beep.wav"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}